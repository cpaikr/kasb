{
  "name": "kasb-workspace",
  "private": true,
  "packageManager": "bun@1.3.13",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "bun run build:ts && bun run build:rust",
    "build:ts": "bun run --cwd packages/kasb-ts build",
    "build:rust": "cargo build --workspace --locked",
    "typecheck": "bun run typecheck:ts && bun run typecheck:evals",
    "typecheck:ts": "bun run --cwd packages/kasb-ts typecheck",
    "typecheck:evals": "tsc --noEmit -p tsconfig.json",
    "test": "bun run test:ts && bun run test:rust",
    "test:ts": "bun test packages/kasb-ts evals",
    "test:rust": "cargo test --workspace --locked",
    "test:live": "bun run --cwd packages/kasb-ts test:live",
    "contracts:check": "node scripts/validate-contracts.mjs && node scripts/check-public-declarations.mjs",
    "conformance:judge": "bun test conformance/judge.test.ts conformance/cli-judge.test.ts packages/kasb-ts/test/conformance/conformance.test.ts",
    "native:feasibility": "node scripts/test-native-feasibility.mjs"
  },
  "devDependencies": {
    "@seriousme/openapi-schema-validator": "2.9.1",
    "@types/bun": "^1.3.1",
    "ajv": "8.20.0",
    "typescript": "^5.9.0",
    "yaml": "^2.9.0"
  }
}
