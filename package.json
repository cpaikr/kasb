{
  "name": "@sjunepark/kasb",
  "version": "0.2.0",
  "description": "Read-only CLI for searching and retrieving KASB standards and Q&A material.",
  "license": "Elastic-2.0",
  "type": "module",
  "packageManager": "bun@1.3.13",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sjunepark/kasb.git"
  },
  "bin": {
    "kasb": "dist/cli.js"
  },
  "exports": {
    "./toolset": {
      "types": "./dist/toolset.d.ts",
      "import": "./dist/toolset.js"
    },
    "./pi": {
      "types": "./dist/pi.d.ts",
      "import": "./dist/pi.js"
    }
  },
  "pi": {
    "extensions": [
      "./dist/pi-extension.js"
    ]
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=20.18.1"
  },
  "scripts": {
    "build": "bun run scripts/build-cli.ts",
    "prepack": "bun run build",
    "prepublishOnly": "bun run typecheck && bun test",
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "test:live": "LIVE_KASB_TESTS=1 bun test"
  },
  "dependencies": {
    "commander": "^14.0.3",
    "effect": "^3.17.0"
  },
  "devDependencies": {
    "@types/bun": "^1.3.1",
    "typescript": "^5.9.0"
  }
}
